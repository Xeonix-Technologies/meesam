# Copy to .env for local development. Railway supplies all of these in staging/production.
NODE_ENV=development
APP_URL=http://localhost:3000
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar
INVOICE_ISSUER=Xeonix Technologies
EMAIL_FROM=no-reply@meesam.ae
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meesam
DATABASE_POOL_URL=postgres://postgres:postgres@localhost:5432/meesam
VAULT_BUCKET=
VAULT_ENDPOINT=
VAULT_ACCESS_KEY_ID=
VAULT_SECRET_ACCESS_KEY=
PUBLICATIONS_BUCKET=
PUBLICATIONS_ENDPOINT=
PUBLICATIONS_ACCESS_KEY_ID=
PUBLICATIONS_SECRET_ACCESS_KEY=
AUTH_SECRET=change-me
EMAIL_PROVIDER_KEY=
AI_PROVIDER_KEY=
AI_MODEL=claude-sonnet-5-5
EMBEDDINGS_URL=http://localhost:8000

MIGRATIONS_DIR=packages/db/migrations
WORKER_POLL_MS=5000
APP_URL=http://localhost:3000
EMAIL_FROM=Meesam <no-reply@meesam.ae>
EMAIL_STREAM=outbound

# first System Administrator(s), comma-separated e-mails (Staff Services and Pages, Section 2)
SYSTEM_ADMIN_EMAILS=
# Second copy of the database, with another company and region (Founder ruling 21 Nov 2026: Cloudflare R2, EU jurisdiction)
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
# Nightly copy: hour (UTC) after which it runs, days every copy is kept, and the weekly restore test (off to disable)
BACKUP_HOUR_UTC=22
BACKUP_KEEP_DAYS=35
BACKUP_RESTORE_TEST=on
BACKUP_NAME_TZ=Asia/Dubai
