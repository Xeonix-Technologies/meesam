{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "apps/worker/Dockerfile", "watchPatterns": ["apps/worker/**", "packages/**", "pnpm-lock.yaml", "package.json"] },
  "deploy": { "healthcheckPath": "/health", "healthcheckTimeout": 60, "restartPolicyType": "ALWAYS", "numReplicas": 1 }
}
