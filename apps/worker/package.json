{
  "name": "@meesam/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "build": "esbuild src/main.ts src/migrate.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --external:postgres --external:drizzle-orm",
    "start": "node dist/main.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo skip",
    "test": "echo skip"
  },
  "dependencies": {
    "@meesam/db": "workspace:*",
    "@meesam/i18n": "workspace:*",
    "drizzle-orm": "0.44.5",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "esbuild": "0.25.9",
    "typescript": "5.9.3"
  }
}
