# Copy to .env for local development. Railway supplies all of these in staging/production.
NODE_ENV=development
APP_URL=http://localhost:3000
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ar
INVOICE_ISSUER=Xeonix Technologies
EMAIL_FROM=no-reply@meesam.ae
DATABASE_URL=postgres://postgres:postgres@localhost:5432/meesam
DATABASE_POOL_URL=postgres://postgres:postgres@localhost:5432/meesam
VAULT_BUCKET=
VAULT_ENDPOINT=
VAULT_ACCESS_KEY_ID=
VAULT_SECRET_ACCESS_KEY=
PUBLICATIONS_BUCKET=
PUBLICATIONS_ENDPOINT=
PUBLICATIONS_ACCESS_KEY_ID=
PUBLICATIONS_SECRET_ACCESS_KEY=
AUTH_SECRET=change-me
# Seals two-step sign-in (authenticator) secrets, web service only (ruling R13). At least 32 characters; set once, sealed, never changed:
# changing or losing it locks every authenticator out until each user sets one up again. Empty = secrets stored unsealed.
TWO_FACTOR_KEY=
# Name an authenticator entry carries (web service); unset = Meesam. A test environment sets its own, e.g. Meesam Staging
TWO_FACTOR_ISSUER=
# New accounts: open = anyone can register; unset or anything else = closed, with an "opens soon" notice (web service)
SIGNUP=open
EMAIL_PROVIDER_KEY=
AI_PROVIDER_KEY=
AI_MODEL=claude-sonnet-5-5
# The picture service inside the private network (worker; and web, for the staff page "Compare two pictures"). Unset = no vectors are made, and nothing fails.
EMBEDDINGS_URL=http://localhost:8000
# Relays (27 Nov 2026): a small server of Meesam's own inside a registry's country, for sites that answer only local networks.
# One variable per relay, on the worker: FETCH_RELAY_<NAME>=https://user:password@host:port . A source names its relay in fetch_spec.via.
FETCH_RELAY_SA=
# Publications received by e-mail (trial on staging, 26 Nov 2026). Unset = the route answers 404.
# INBOUND_MAIL_KEY: a long random secret, also given to the mail provider as the webhook password. INBOUND_MAIL_SENDERS: addresses or @domains, comma-separated.
INBOUND_MAIL_KEY=
INBOUND_MAIL_SENDERS=

MIGRATIONS_DIR=packages/db/migrations
WORKER_POLL_MS=5000
APP_URL=http://localhost:3000
EMAIL_FROM=Meesam <no-reply@meesam.ae>
EMAIL_STREAM=outbound

# first System Administrator(s), comma-separated e-mails (Staff Services and Pages, Section 2)
SYSTEM_ADMIN_EMAILS=
# Second copy of the database, with another company and region (Founder ruling 21 Nov 2026: Cloudflare R2, EU jurisdiction)
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
# Nightly copy: hour (UTC) after which it runs, days every copy is kept, and the weekly restore test (off to disable)
BACKUP_HOUR_UTC=22
BACKUP_KEEP_DAYS=35
BACKUP_RESTORE_TEST=on
BACKUP_NAME_TZ=Asia/Dubai
AI_TRANSLATE_MODEL=claude-haiku-5-5
